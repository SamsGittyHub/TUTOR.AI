# Railway Postgres connection string (Variables tab → DATABASE_URL).
# A local docker one for development:
#   docker run -d --name tutorai-pg -e POSTGRES_PASSWORD=tutorai \
#     -e POSTGRES_USER=tutorai -e POSTGRES_DB=tutorai -p 55432:5432 postgres:16-alpine
DATABASE_URL=postgres://tutorai:tutorai@localhost:55432/tutorai

# Where uploaded originals are written. On Railway, point this at a mounted volume.
TUTOR_AI_STORAGE_DIR=./.storage

# Encrypts stored provider API keys (AES-256-GCM). Any long random string:
#   openssl rand -base64 48
# Without it the server refuses to store keys at all, and the "remember my key"
# option disappears from Settings. Rotating it makes existing stored keys
# undecryptable — students are asked to paste them again, nothing else breaks.
TUTOR_AI_KEY_SECRET=

# Single-paste env for the shared OpenAI key used by the beta gateway.
OPENAI_API_KEY=
BETA_OPENAI_KEY=
TUTOR_AI_OPENAI_KEY=

# Optional local tuning.
PGPOOL_MAX=10
