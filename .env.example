# Railway Postgres connection string (Variables tab → DATABASE_URL).
# A local docker one for development:
#   docker run -d --name chalk-pg -e POSTGRES_PASSWORD=chalk -e POSTGRES_USER=chalk \
#     -e POSTGRES_DB=chalk -p 55432:5432 postgres:16-alpine
DATABASE_URL=postgres://chalk:chalk@localhost:55432/chalk

# Where uploaded originals are written. On Railway, point this at a mounted volume.
CHALK_STORAGE_DIR=./.storage
